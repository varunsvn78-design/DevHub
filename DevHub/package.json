{
  "name": "devhub",
  "version": "1.0.0",
  "description": "DevHub \u2014 GitHub Developer & Repository Analytics platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch backend/server.js",
    "build": "tailwindcss -i ./frontend/input.css -o ./frontend/styles.css --minify",
    "dev:css": "tailwindcss -i ./frontend/input.css -o ./frontend/styles.css --watch",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varunsvn78-design/DevHub.git"
  },
  "homepage": "https://github.com/varunsvn78-design/DevHub#readme",
  "bugs": {
    "url": "https://github.com/varunsvn78-design/DevHub/issues"
  }
}
